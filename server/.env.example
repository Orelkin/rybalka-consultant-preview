# Configure these variables on the server. This file contains no credentials.
RECON_AI_PROVIDER=none
OPENAI_API_KEY=
RECON_EXTRACT_MODEL=
RECON_ANALYZE_MODEL=
RECON_DAILY_MAX_CALLS=3
RECON_DAILY_TOKEN_BUDGET=30000
RECON_MAX_INPUT_BYTES=14000
RECON_MAX_OUTPUT_TOKENS=1600
# Background work is off until hosting and AI access are approved/configured.
RECON_UPDATE_INTERVAL_SECONDS=0
RECON_ALLOWED_ORIGINS=https://orelkin.github.io
# Mount persistent storage outside the public application directory.
RECON_DB_PATH=/var/lib/rybalka/recon.sqlite
RECON_HOST=127.0.0.1
PORT=8787
